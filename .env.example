# Axiom Engine Environment Configuration
# NOTE: Axiom Engine works 100% OFFLINE without any API keys!
# All 4 presets, symbolic checks, simulations, and Web Speech hints require ZERO API keys.

# Optional: Google Gemini API Key for handwritten photo OCR and Text-to-Physics compilation
# You can also use client-side BYOK in the Lab Settings drawer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Voice hint cloud synthesis (falls back to native browser Web Speech API when omitted)
GROQ_API_KEY=
ELEVENLABS_API_KEY=
