      "bbox": { "x": 40, "y": 150, "width": 350, "height": 50 }
    },
    {
      "step_number": 4,
      "latex": "T = m_1 a + \\mu m_1 g",
      "lhs": "T",
      "expr": "m1*((m2 - mu*m1)*g / (m1 - m2)) + mu*m1*g",
      "reference_expr": "m1*((m2 - mu*m1)*g / (m1 + m2)) + mu*m1*g",
      "status": "PROPAGATED",
      "error_type": "PROPAGATED_ERROR",
      "explanation": "Tension evaluated with the wrong acceleration from step 3.",
      "socratic_hint": "Fix the acceleration in step 3 first.",
      "socratic_hint_hinglish": "Pehle step 3 ka acceleration theek karo.",
      "corrected_step_latex": "T = m_1\\left(\\frac{(m_2 - \\mu m_1)g}{m_1 + m_2}\\right) + \\mu m_1 g",
