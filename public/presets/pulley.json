  "derivation_steps": [
    {
      "step_number": 1,
      "latex": "T = m_1 a + \\mu m_1 g",
      "lhs": "T",
      "expr": "m1*a + mu*m1*g",
      "reference_expr": "m1*a + mu*m1*g",
      "status": "VALID",
      "explanation": "Correct equation of motion for horizontal block m1.",
      "bbox": { "x": 40, "y": 30, "width": 320, "height": 40 }
    },
    {
      "step_number": 2,
      "latex": "T = m_2 g - m_2 a",
      "lhs": "T",
      "expr": "m2*g - m2*a",
      "reference_expr": "m2*g - m2*a",
      "status": "VALID",
      "explanation": "Correct equation of motion for vertical hanging block m2.",
      "bbox": { "x": 40, "y": 90, "width": 320, "height": 40 }
    },
    {
      "step_number": 3,
      "latex": "a = \\frac{(m_2 - \\mu m_1)g}{m_1 - m_2}",
